{
  "name": "axondeck",
  "desktopName": "axondeck",
  "version": "1.62.1",
  "description": "AxonDeck - Windows Desktop AI Workbench",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src scripts && node scripts/lint-ipc.js",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:pack": "node scripts/pack-preview.js",
    "dev:sandbox": "node scripts/dev-sandbox.js",
    "electron:build": "node scripts/pack-preview.js --release",
    "start": "electron .",
    "test:sysmon": "node scripts/test-sysmon.js",
    "build:sensors": "dotnet publish native/sysmon-sensors -c Release -o resources/sensors",
    "build:hook": "dotnet publish native/dictation-hook -c Release -o resources/hook",
    "build:shell": "dotnet publish native/explorer-shell -c Release -o resources/shell",
    "build:probe": "cargo build --release --manifest-path native/axondeck-probe/Cargo.toml && node scripts/copy-probe.js",
    "build:media": "node scripts/build-media.js",
    "electron:pack:linux": "vite build && electron-builder --linux AppImage --publish never",
    "electron:build:linux": "vite build && electron-builder --linux AppImage deb rpm --publish never",
    "release:linux": "node scripts/release-linux.js"
  },
  "author": "",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/RX5950XT/AxonDeck.git"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "11.12.0",
    "concurrently": "^9.1.2",
    "electron": "43.7.5",
    "electron-builder": "^26.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "gemoji": "8.1.0",
    "globals": "17.12.0",
    "katex": "0.19.0",
    "mermaid": "11.17.2",
    "vite": "^6.2.0",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron-chrome-extensions": "4.9.0",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "monaco-editor": "^0.55.1",
    "node-edge-tts": "1.2.11",
    "opencc-js": "^1.4.1",
    "pdfjs-dist": "6.3.289",
    "smol-toml": "^1.9.0",
    "uiohook-napi": "^1.5.5"
  },
  "build": {
    "appId": "com.voiceink.app",
    "productName": "AxonDeck",
    "directories": {
      "output": "dist"
    },
    "asar": {
      "smartUnpack": false
    },
    "asarUnpack": [
      "**/node_modules/@lydell/node-pty*/**",
      "**/node_modules/uiohook-napi/**",
      "src/main/usage/read-windows-credential.ps1",
      "src/main/sysmon/probe.ps1",
      "src/main/screentime/observer.ps1"
    ],
    "files": [
      "**/*",
      "!.claude/**",
      "!start.log",
      "!**/node_modules/@napi-rs/**",
      "!**/node_modules/pdfjs-dist/**",
      "**/node_modules/pdfjs-dist/package.json",
      "**/node_modules/pdfjs-dist/build/pdf.min.mjs",
      "**/node_modules/pdfjs-dist/build/pdf.worker.min.mjs",
      "!**/node_modules/monaco-editor/**",
      "**/node_modules/monaco-editor/package.json",
      "**/node_modules/monaco-editor/min/**",
      "!dist/**",
      "!dist-*/**",
      "!designs/**",
      "!binary-backups/**",
      "!tasks/**",
      "!resources/media/**",
      "!native/**",
      "!eslint.config.mjs",
      "!**/__pycache__/**",
      {
        "from": "node_modules/mermaid/dist",
        "to": "node_modules/mermaid/dist",
        "filter": [
          "mermaid.esm.min.mjs",
          "chunks/mermaid.esm.min/**",
          "!**/*.map"
        ]
      },
      {
        "from": "node_modules/katex/dist",
        "to": "node_modules/katex/dist",
        "filter": [
          "katex.mjs"
        ]
      },
      {
        "from": "node_modules/@highlightjs/cdn-assets/es",
        "to": "node_modules/@highlightjs/cdn-assets/es",
        "filter": [
          "highlight.min.js",
          "languages/*.min.js"
        ]
      },
      {
        "from": "node_modules/gemoji",
        "to": "node_modules/gemoji",
        "filter": [
          "index.js"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "RX5950XT",
        "repo": "AxonDeck"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "resources/media",
        "to": "media",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/sensors",
        "to": "sensors",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/hook",
        "to": "hook",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/shell",
        "to": "shell",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/probe",
        "to": "probe",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "syncDesktopName": true,
      "executableName": "axondeck",
      "maintainer": "RX5950XT <123271969+RX5950XT@users.noreply.github.com>",
      "vendor": "RX5950XT",
      "synopsis": "AxonDeck desktop AI workbench",
      "description": "AxonDeck: desktop AI workbench with chat, terminal, file explorer, live captions and system monitor.",
      "desktop": {
        "entry": {
          "Name": "AxonDeck",
          "Comment[zh_TW]": "桌面 AI 工作台",
          "Keywords": "AI;Chat;Terminal;Explorer;",
          "StartupNotify": "true"
        }
      }
    },
    "deb": {
      "packageCategory": "utils",
      "priority": "optional",
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0",
        "libasound2 | libasound2t64",
        "libgbm1",
        "libdrm2"
      ],
      "recommends": [
        "gvfs",
        "gvfs-backends",
        "libglib2.0-bin",
        "gnome-keyring | kwalletmanager",
        "pkexec | policykit-1",
        "x11-utils"
      ]
    },
    "rpm": {
      "packageCategory": "Applications/Utilities",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "(libuuid or libuuid1)",
        "(libsecret or libsecret-1-0)",
        "(alsa-lib or libasound2)",
        "(mesa-libgbm or libgbm1)"
      ],
      "fpm": [
        "--rpm-tag",
        "Recommends: gvfs",
        "--rpm-tag",
        "Recommends: (glib2 or glib2-tools)",
        "--rpm-tag",
        "Recommends: polkit",
        "--rpm-tag",
        "Recommends: xprop"
      ]
    }
  }
}
