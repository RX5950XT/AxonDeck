{
  "name": "axondeck",
  "desktopName": "axondeck",
  "version": "1.85.1",
  "description": "AxonDeck - Windows Desktop AI Workbench",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src scripts && node scripts/lint-ipc.js",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:pack": "node scripts/pack-preview.js",
    "dev:sandbox": "node scripts/dev-sandbox.js",
    "electron:build": "node scripts/pack-preview.js --release",
    "start": "electron .",
    "test:sysmon": "node scripts/test-sysmon.js",
    "build:sensors": "dotnet publish native/sysmon-sensors -c Release -o resources/sensors",
    "build:hook": "dotnet publish native/dictation-hook -c Release -o resources/hook",
    "build:shell": "dotnet publish native/explorer-shell -c Release -o resources/shell",
    "build:probe": "cargo build --release --manifest-path native/axondeck-probe/Cargo.toml && node scripts/copy-probe.js",
    "build:media": "node scripts/build-media.js",
    "electron:pack:linux": "vite build && electron-builder --linux AppImage --publish never",
    "electron:build:linux": "vite build && electron-builder --linux AppImage --publish never"
  },
  "author": "",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@highlightjs/cdn-assets": "11.12.0",
    "concurrently": "^9.1.2",
    "electron": "43.7.5",
    "electron-builder": "^26.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "gemoji": "8.1.0",
    "globals": "17.12.0",
    "katex": "0.19.0",
    "mermaid": "11.17.2",
    "vite": "^6.2.0",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron-chrome-extensions": "4.9.0",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "monaco-editor": "^0.55.1",
    "node-edge-tts": "1.2.11",
    "opencc-js": "^1.4.1",
    "pdfjs-dist": "6.3.289",
    "smol-toml": "^1.9.0",
    "uiohook-napi": "^1.5.5"
  },
  "build": {
    "appId": "com.voiceink.app",
    "productName": "AxonDeck",
    "directories": {
      "output": "dist"
    },
    "asar": {
      "smartUnpack": false
    },
    "asarUnpack": [
      "**/node_modules/@lydell/node-pty*/**",
      "**/node_modules/uiohook-napi/**",
      "src/main/usage/read-windows-credential.ps1",
      "src/main/sysmon/probe.ps1",
      "src/main/screentime/observer.ps1"
    ],
    "files": [
      "**/*",
      "!.claude/**",
      "!start.log",
      "!**/node_modules/@napi-rs/**",
      "!**/node_modules/pdfjs-dist/**",
      "**/node_modules/pdfjs-dist/package.json",
      "**/node_modules/pdfjs-dist/build/pdf.min.mjs",
      "**/node_modules/pdfjs-dist/build/pdf.worker.min.mjs",
      "!**/node_modules/monaco-editor/**",
      "**/node_modules/monaco-editor/package.json",
      "**/node_modules/monaco-editor/min/**",
      "!dist/**",
      "!dist-*/**",
      "!designs/**",
      "!binary-backups/**",
      "!tasks/**",
      "!resources/media/**",
      "!native/**",
      "!eslint.config.mjs",
      "!**/__pycache__/**",
      {
        "from": "node_modules/mermaid/dist",
        "to": "node_modules/mermaid/dist",
        "filter": [
          "mermaid.esm.min.mjs",
          "chunks/mermaid.esm.min/**",
          "!**/*.map"
        ]
      },
      {
        "from": "node_modules/katex/dist",
        "to": "node_modules/katex/dist",
        "filter": [
          "katex.mjs"
        ]
      },
      {
        "from": "node_modules/@highlightjs/cdn-assets/es",
        "to": "node_modules/@highlightjs/cdn-assets/es",
        "filter": [
          "highlight.min.js",
          "languages/*.min.js"
        ]
      },
      {
        "from": "node_modules/gemoji",
        "to": "node_modules/gemoji",
        "filter": [
          "index.js"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "RX5950XT",
        "repo": "AxonDeck"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "resources/media",
        "to": "media",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/sensors",
        "to": "sensors",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/hook",
        "to": "hook",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/shell",
        "to": "shell",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/probe",
        "to": "probe",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "syncDesktopName": true,
      "desktop": {
        "MimeType": "image/jpeg;image/png;image/apng;image/gif;image/webp;image/avif;image/heic;image/heif;application/x-extension-hif;application/x-extension-jxl;image/bmp;application/x-extension-dib;image/tiff;image/x-icon;application/x-extension-cur;image/svg+xml;application/x-extension-svgz;application/x-extension-psd;application/x-extension-psb;application/x-extension-tga;application/x-extension-dds;application/x-extension-exr;application/x-extension-hdr;application/x-extension-pic;application/x-extension-jp2;application/x-extension-j2k;application/x-extension-jpf;application/x-extension-jpx;application/x-extension-jpm;application/x-extension-jpc;application/x-extension-pcx;application/x-extension-pnm;application/x-extension-pbm;application/x-extension-pgm;application/x-extension-ppm;application/x-extension-pam;application/x-extension-qoi;application/x-extension-mng;application/x-extension-jng;application/x-extension-xcf;application/x-extension-dng;application/x-extension-cr2;application/x-extension-cr3;application/x-extension-crw;application/x-extension-nef;application/x-extension-nrw;application/x-extension-arw;application/x-extension-srf;application/x-extension-sr2;application/x-extension-raf;application/x-extension-rw2;application/x-extension-orf;application/x-extension-pef;application/x-extension-srw;application/x-extension-raw;application/x-extension-x3f;application/x-extension-3fr;application/x-extension-fff;application/x-extension-erf;application/x-extension-rwl;application/x-extension-mos;application/x-extension-kdc;application/x-extension-dcr;application/x-extension-mrw;video/mp4;video/x-m4v;video/x-matroska;video/webm;video/x-msvideo;video/quicktime;video/x-ms-wmv;application/x-extension-asf;video/x-flv;application/x-extension-f4v;application/x-extension-mts;video/mp2t;application/x-extension-m2t;application/x-extension-mpg;application/x-extension-mpeg;application/x-extension-mpe;application/x-extension-m1v;application/x-extension-m2v;application/x-extension-vob;application/x-extension-ogv;audio/ogg;application/x-extension-3gp;application/x-extension-3g2;application/x-extension-rm;application/x-extension-rmvb;application/x-extension-divx;application/x-extension-amv;application/x-extension-nut;application/x-extension-nsv;application/x-extension-mxf;application/x-extension-y4m;application/x-extension-h264;application/x-extension-264;application/x-extension-h265;application/x-extension-265;application/x-extension-hevc;application/x-extension-ivf;application/x-extension-bik;application/x-extension-bk2;application/x-extension-smk;audio/mpeg;audio/flac;audio/wav;audio/mp4;audio/aac;audio/opus;audio/aiff;application/x-extension-aif;application/x-extension-aifc;application/x-extension-alac;application/x-extension-ape;application/x-extension-wv;audio/x-ms-wma;application/x-extension-ac3;application/x-extension-eac3;application/x-extension-dts;application/x-extension-dsf;application/x-extension-dff;application/x-extension-tta;application/x-extension-tak;application/x-extension-mka;application/x-extension-mp2;application/x-extension-mpa;application/x-extension-au;application/x-extension-snd;application/x-extension-caf;application/x-extension-amr;application/x-extension-weba;application/x-extension-spx;application/x-extension-m4b;application/x-extension-mod;application/x-extension-xm;application/x-extension-it;application/x-extension-s3m;audio/x-mpegurl;application/vnd.apple.mpegurl;audio/x-scpls;application/x-cue;text/plain;text/markdown;application/json;text/csv;application/xml;text/html;text/css;text/javascript;text/x-python;text/rust;text/x-go;text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;text/x-java;text/x-kotlin;application/x-shellscript;application/x-yaml;application/toml;application/sql;text/x-tex;application/rtf;application/x-desktop"
      }
    }
  }
}
